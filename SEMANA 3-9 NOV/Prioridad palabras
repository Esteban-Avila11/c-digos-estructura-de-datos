package prioridadpalabras;

import java.util.PriorityQueue;

public class PrioridadPalabras {

    public static void main(String[] args) {

        PriorityQueue<String> cola = new PriorityQueue<>();

        cola.offer("Esteban");      
        cola.offer("Bogota");     
        cola.offer("Tecnologia en Informatica"); 
        cola.offer("Java");       

        System.out.println(cola);

        // Mi predicción: la cabeza será "Bogota", porque es la primera
        // en orden alfabético (la B va antes que la E, la T y la J).
        System.out.println("Cabeza: " + cola.peek());

        while (!cola.isEmpty()) {
            System.out.println(cola.poll());
        }
    }
}
