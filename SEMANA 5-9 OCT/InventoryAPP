package inventario;

/**
 *
 * @author Esteban Avila
 */
import java.util.InputMismatchException;
import java.util.Scanner;

public class InventoryApp {

    private Scanner sc = new Scanner(System.in);

    private Inventory inventory;

    public static void main(String[] args) {

        InventoryApp app = new InventoryApp();

        app.init();
    }

    // ============================================
    // INICIAR EL PROGRAMA
    // ============================================
    public void init() {
        // Crea el inventario
        inventory = new Inventory();
        int op = 0;
        // Repite el menú hasta seleccionar 8
        do {
            System.out.println("\n\t MENÚ");
            System.out.println("---- MANEJO DE INVENTARIOS ----");
            System.out.println("1. Nuevo producto");
            System.out.println("2. Agregar existencia");
            System.out.println("3. Eliminar producto");
            System.out.println("4. Actualizar precio");
            System.out.println("5. Mostrar productos");
            System.out.println("6. Consultar producto");
            System.out.println("7. Cambiar categoría");
            System.out.println("8. Salir");
            System.out.println("\nSeleccione una opción:");

            try {
                // Lee la opción seleccionada
                op = sc.nextInt();
            } catch (InputMismatchException e) {
                // El usuario escribió algo que no es un número
                sc.nextLine();
                System.out.println("\nEscriba un número válido");
                op = 0;
                continue;
            }

            try {
                // Ejecuta la opción seleccionada
                switch (op) {
                    case 1:
                        newProduct();
                        break;
                    case 2:
                        addProduct();
                        break;
                    case 3:
                        deleteProduct();
                        break;
                    case 4:
                        updateProduct();
                        break;
                    case 5:
                        printProduct();
                        break;
                    case 6:
                        searchProduct();
                        break;
                    case 7:
                        updateCategory();
                        break;
                    case 8:
                        System.out.println("\nHasta pronto");
                        break;
                    default:
                        System.out.println("\nOpción no válida");
                }
            } catch (InputMismatchException e) {
                // Dato con formato incorrecto dentro de una opción
                sc.nextLine();
                System.out.println("\nEntrada no válida, intente de nuevo");
            }

        } while (op != 8);
    }

    private void newProduct() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        System.out.println("Nombre del producto:");
        String name = sc.next();

        System.out.println("Categoría del producto:");
        String category = sc.next();

        System.out.println("Existencia inicial:");
        int existence = sc.nextInt();

        System.out.println("Precio del producto:");
        double price = sc.nextDouble();

        // Envía los datos a Inventory
        inventory.newProduct(
            ID, name, existence, price, category);
    }

    private void addProduct() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        // Inventory aumenta la existencia
        inventory.addProduct(ID);
    }

    private void deleteProduct() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        // Inventory elimina el producto
        inventory.deleteProduct(ID);
    }

    private void updateProduct() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        System.out.println("Nuevo precio:");
        double price = sc.nextDouble();

        // Inventory modifica el precio
        inventory.updateProduct(ID, price);
    }

    private void updateCategory() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        System.out.println("Nueva categoría:");
        String category = sc.next();

        // Inventory modifica la categoría
        inventory.updateCategory(ID, category);
    }

    private void searchProduct() {
        System.out.println("ID del producto:");
        int ID = sc.nextInt();

        // Inventory muestra los datos del producto
        inventory.searchProduct(ID);
    }

    private void printProduct() {
        // Inventory muestra la lista
        inventory.printProducts();
    }

}

